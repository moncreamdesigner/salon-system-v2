Options -Indexes
DirectoryIndex booking.html

# HTML bolon version file-iig shineer shalgana. Build dugaartai CSS/JS ni
# daraagiin deploy hurtel browser cache-aas shuud ajillana.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
    Header always unset Pragma
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

RewriteEngine On

RewriteCond %{REQUEST_URI} \.(html|json)$ [NC]
RewriteRule .* - [E=Cache-Control:no-cache]

# /login/ хаягийг нэг стандарт /login хаяг руу оруулна.
RewriteCond %{THE_REQUEST} \s/+login/[?\s] [NC]
RewriteRule ^login/$ /login [R=302,L]

RewriteCond %{THE_REQUEST} \s/+((?:catalog|booking|results))/[?\s] [NC]
RewriteRule ^(catalog|booking|results)/$ /$1 [R=302,L]

RewriteRule ^(catalog|booking|results)$ booking.html [L]

# Одоогийн салон удирдлагын систем.
RewriteRule ^login$ index.html [L]
