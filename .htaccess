Options -Indexes
DirectoryIndex booking.html

# HTML, CSS, JS-iig huudas neeh burd shinechlegdsen esehiig serverees shalgana.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

RewriteEngine On

RewriteCond %{REQUEST_URI} \.(html|css|js|json)$ [NC]
RewriteRule .* - [E=Cache-Control:no-cache]

# /login/ хаягийг нэг стандарт /login хаяг руу оруулна.
RewriteCond %{THE_REQUEST} \s/+login/[?\s] [NC]
RewriteRule ^login/$ /login [R=302,L]

RewriteCond %{THE_REQUEST} \s/+((?:catalog|booking|results))/[?\s] [NC]
RewriteRule ^(catalog|booking|results)/$ /$1 [R=302,L]

RewriteRule ^(catalog|booking|results)$ booking.html [L]

# Одоогийн салон удирдлагын систем.
RewriteRule ^login$ index.html [L]
